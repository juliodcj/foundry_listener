# Token do bot (Discord Developer Portal → sua aplicação → Bot → Reset Token)
DISCORD_TOKEN=

# ID do servidor do Discord (clique direito no servidor → Copiar ID do servidor)
GUILD_ID=

# Seu ID de usuário no Discord (clique direito no seu nome → Copiar ID do usuário).
# Quando você entrar num canal de voz, o bot entra junto.
GM_DISCORD_ID=

# Opcional: se preenchido, o bot só entra automaticamente neste canal de voz.
VOICE_CHANNEL_ID=

# Porta do WebSocket local (só 127.0.0.1). Tem que ser a mesma da configuração do módulo.
WS_PORT=8770
